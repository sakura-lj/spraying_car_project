<launch>
  <arg name="use_lidar" default="true"/>
  <arg name="use_point_lio" default="true"/>
  <arg name="use_bridge" default="true"/>
  <arg name="bridge_publish_tf" default="false"/>
  <arg name="use_rviz" default="false"/>
  <arg name="lidar_port" default="/dev/ttyUSB0"/>

  <include file="$(find spraying_car_description)/launch/description.launch">
    <arg name="use_rviz" value="false"/>
  </include>

  <group if="$(arg use_lidar)">
    <include file="$(find spraying_car_slam)/launch/unilidar.launch">
      <arg name="lidar_port" value="$(arg lidar_port)"/>
      <arg name="use_rviz" value="false"/>
    </include>
  </group>

  <group if="$(arg use_point_lio)">
    <include file="$(find spraying_car_slam)/launch/point_lio_mapping.launch">
      <arg name="rviz" value="false"/>
    </include>
  </group>

  <group if="$(arg use_bridge)">
    <include file="$(find spraying_car_localization)/launch/point_lio_bridge.launch">
      <arg name="publish_tf" value="$(arg bridge_publish_tf)"/>
    </include>
  </group>

  <node pkg="rviz"
        type="rviz"
        name="slam_rviz"
        args="-d $(find spraying_car_slam)/rviz/slam.rviz"
        if="$(arg use_rviz)"/>
</launch>
