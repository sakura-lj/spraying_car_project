<launch>
  <arg name="use_rviz" default="false"/>
  <arg name="lidar_port" default="/dev/ttyUSB0"/>
  <arg name="use_lidar" default="true"/>
  <arg name="use_point_lio" default="true"/>

  <include file="$(find spraying_car_slam)/launch/slam.launch">
    <arg name="use_description" value="true"/>
    <arg name="use_lidar" value="$(arg use_lidar)"/>
    <arg name="use_point_lio" value="$(arg use_point_lio)"/>
    <arg name="use_rviz" value="$(arg use_rviz)"/>
    <arg name="lidar_port" value="$(arg lidar_port)"/>
  </include>
</launch>
