<launch>
  <arg name="use_rviz" default="false"/>
  <arg name="use_joint_state_publisher" default="false"/>
  <arg name="model" default="$(find spraying_car_description)/urdf/spraying_car.urdf.xacro"/>

  <param name="robot_description" command="$(find xacro)/xacro '$(arg model)'"/>

  <node pkg="robot_state_publisher"
        type="robot_state_publisher"
        name="robot_state_publisher"
        output="screen"/>

  <node pkg="joint_state_publisher"
        type="joint_state_publisher"
        name="joint_state_publisher"
        output="screen"
        if="$(arg use_joint_state_publisher)"/>

  <node pkg="rviz"
        type="rviz"
        name="rviz"
        args="-d $(find spraying_car_description)/rviz/description.rviz"
        if="$(arg use_rviz)"/>
</launch>
